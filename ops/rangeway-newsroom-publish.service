[Unit]
Description=Build and publish due Rangeway Newsroom content
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=HOME=/var/lib/rangeway-newsroom
ExecStart=/usr/local/bin/rangeway-newsroom-publish
TimeoutStartSec=240
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rangeway-newsroom /var/www/rangeway-newsroom
